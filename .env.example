APP_NAME=AlphaPilot AI
ENVIRONMENT=development
LOG_LEVEL=INFO
# OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
MAX_AGENT_ITERATIONS=2
MAX_CONCURRENT_LLM_REQUESTS=10
LLM_QUEUE_TIMEOUT_SECONDS=5.0
RAG_PREWARM_ON_STARTUP=false

# Persistent Vector Storage (PostgreSQL + pgvector)
# Keep in_memory for local offline dev/unit tests, or set to postgres with DATABASE_URL below.
RAG_STORAGE_BACKEND=in_memory
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alphapilot
EMBEDDING_DIMENSION=1536
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10.0
DB_ECHO=false

# Multi-User Auth & Broker Token Encryption (Days 17-20)
# Generate strong keys via Python: secrets.token_urlsafe(32) / base64.b64encode(os.urandom(32))
# AUTH_SECRET_KEY=replace-with-32+-byte-random-secret
AUTH_TOKEN_TTL_SECONDS=3600
# Format: v1:<base64_32_byte_key>[,v0:<previous_base64_32_byte_key>] or JSON object
# BROKER_TOKEN_ENCRYPTION_KEYS=v1:replace-with-base64-encoded-32-byte-aes-gcm-key
# BROKER_ACTIVE_ENCRYPTION_KEY_ID=v1
BROKER_OAUTH_STATE_TTL_SECONDS=600
OAUTH_COOKIE_SECURE=false

# Zerodha Kite Connect v3 (Read-only Portfolio Ingestion)
# ZERODHA_API_KEY=your-kite-api-key
# ZERODHA_API_SECRET=your-kite-api-secret
# ZERODHA_REDIRECT_URI=http://localhost:8000/brokers/zerodha/callback
# ZERODHA_POST_CALLBACK_REDIRECT_URI=http://localhost:3000/portfolio/connected
ZERODHA_API_BASE_URL=https://api.kite.trade
ZERODHA_LOGIN_BASE_URL=https://kite.zerodha.com/connect/login
ZERODHA_TIMEOUT_SECONDS=10.0
ZERODHA_MAX_RETRIES=2
ZERODHA_WORKFLOW_DEADLINE_SECONDS=30.0

# Isolated PostgreSQL Integration Tests (must point to dedicated test DB, NEVER working DB)
# ALPHAPILOT_RUN_PG_TESTS=1
# ALPHAPILOT_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alphapilot_test
